#!/bin/sh
# git review [<name> ...] [<diff args>]: the review of a pending landing.
# `git diff --cached` prefixed with COMMIT_MSG.md when present (the pending
# landing's message); on a work branch (one deploy-branches lists) or in a subagent worktree the
# diff starts from the merge-base with origin/main, so it shows everything
# pending against main (COMMIT_MSG.md itself excluded unless paths are
# given).  Leading arguments that are no paths here but subagent worktree
# names (.claude/worktrees/<name> of this checkout, else of any checkout of
# this repository, a unique prefix each) show those worktrees instead, one
# after the other.
# One pager stream keeps the messages visible on long diffs; colors are
# per-line because less -R drops attributes at line boundaries.
# The nixconvoy package carries it, so `nixconvoy review` runs it anywhere;
# on your own PATH git finds it as `git review`.
set -u
# git exports the invoking worktree's layout to a subcommand; each target
# is addressed with -C instead.
unset GIT_DIR GIT_WORK_TREE
here=$PWD${GIT_PREFIX:+/$GIT_PREFIX}

# The one subagent worktree `$1` names (exactly, else as a unique prefix),
# among every worktree of this repository, in $dir; 1 when none, 2 when
# ambiguous.
resolve() {
    dir=
    n=0
    all=$(git -C "$here" worktree list --porcelain | sed -n 's/^worktree //p')
    # The exact name anywhere, else a prefix: this checkout's first.
    for wt in $all; do
        case "$wt" in */.claude/worktrees/"$1") dir=$wt; return 0 ;; esac
    done
    own="$(git -C "$here" rev-parse --show-toplevel)/.claude/worktrees"
    for d in "$own/$1"*/; do
        [ -d "$d" ] && dir=${d%/} && n=$((n + 1))
    done
    [ "$n" = 1 ] && return 0
    dir=
    n=0
    for wt in $all; do
        case "$wt" in */.claude/worktrees/"$1"*) dir=$wt; n=$((n + 1)) ;; esac
    done
    [ "$n" = 1 ] && return 0
    [ "$n" = 0 ] && return 1
    echo "review: $1 is ambiguous among the subagent worktrees matching $1*" >&2
    return 2
}

# Whether branch $2 matches a pattern of the deploy-branches file $1 (`*`
# the one wildcard).
listed() {
    while IFS= read -r pat; do
        case "$pat" in ''|'#'*) continue ;; esac
        # shellcheck disable=SC2254
        case "$2" in $pat) return 0 ;; esac
    done <"$1"
    return 1
}

targets=
while [ $# -gt 0 ]; do
    case "$1" in -*) break ;; esac
    [ -e "$here/$1" ] && break
    resolve "$1"
    case $? in
    0) targets="$targets $dir"; shift ;;
    1) break ;;
    *) exit 1 ;;
    esac
done

if [ -t 1 ]; then color=--color; else color=; fi

# One checkout's message and diff; $1 its directory, then the diff args.
show() {
    d=$1
    shift
    base=
    cur=$(git -C "$d" symbolic-ref --short -q HEAD)
    case "$d" in */.claude/worktrees/*) base=$(git -C "$d" merge-base origin/main HEAD 2>/dev/null) ;; esac
    if [ -z "$base" ] && [ -n "$cur" ] && [ "$cur" != main ]; then
        top=$(git -C "$d" rev-parse --show-toplevel)
        if [ -f "$top/deploy-branches" ] && listed "$top/deploy-branches" "$cur"; then
            base=$(git -C "$d" merge-base origin/main HEAD 2>/dev/null)
        fi
    fi
    if [ -n "$base" ]; then
        excl=1
        for a in "$@"; do
            case "$a" in -*) ;; *) excl=0 ;; esac
        done
        if [ "$excl" = 1 ]; then
            set -- "$base" "$@" -- ":(top,exclude)COMMIT_MSG.md"
        else
            set -- "$base" "$@"
        fi
    fi
    p="$(git -C "$d" rev-parse --show-toplevel)/COMMIT_MSG.md"
    if [ -f "$p" ]; then
        if [ -n "$color" ]; then
            printf '\033[1m── COMMIT_MSG.md ──\033[0m\n'
            while IFS= read -r l; do printf '\033[36m%s\033[0m\n' "$l"; done <"$p"
        else
            echo "── COMMIT_MSG.md ──"
            cat "$p"
        fi
        echo
    fi
    git -C "$d" diff --cached $color "$@"
}

run() {
    if [ -z "$targets" ]; then
        show "$here" "$@"
        return
    fi
    for d in $targets; do
        label="$(basename "$(dirname "$(dirname "$(dirname "$d")")")")/$(basename "$d")"
        if [ -n "$color" ]; then
            printf '\033[1;33m══ %s ══\033[0m\n' "$label"
        else
            echo "══ $label ══"
        fi
        show "$d" "$@"
        echo
    done
}

if [ -n "$color" ]; then
    run "$@" | { LESS="${LESS:-FRX}" LV="${LV:--c}" eval "$(git var GIT_PAGER)"; }
else
    run "$@"
fi
