#!/bin/sh
# git review: `nixconvoy review` for those who reach it through git - the
# nixconvoy beside this script (the package's bin), else the one on PATH.
# git runs a subcommand from the toplevel with GIT_PREFIX naming the
# caller's directory, and may export the worktree's layout.
set -u
unset GIT_DIR GIT_WORK_TREE
if [ -n "${GIT_PREFIX:-}" ]; then cd "$GIT_PREFIX" || exit; fi
d=$(dirname "$0")
[ -x "$d/nixconvoy" ] && exec "$d/nixconvoy" review "$@"
exec nixconvoy review "$@"
