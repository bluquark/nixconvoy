{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-isolate.sh\"",
            "timeout": 10,
            "statusMessage": "Giving the subagent its own worktree"
          }
        ]
      }
    ]
  }
}
